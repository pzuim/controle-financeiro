{
  "name": "controle-financeiro",
  "private": true,
  "version": "1.0.0",
  "description": "Aplicativo pessoal de controle financeiro (PWA, mobile-first, offline).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "python scripts/generate_icons.py"
  },
  "dependencies": {
    "idb": "8.0.4",
    "preact": "10.29.8",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.5"
  }
}
